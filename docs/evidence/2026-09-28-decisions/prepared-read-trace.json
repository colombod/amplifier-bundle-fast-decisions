<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="dark">
<title>Fast Decisions · Decision Observatory</title>
<style>/* Decision Observatory — dark, high-contrast. Colour carries outcome, never identity alone:
   every coloured chip also carries a label. */
:root {
  color-scheme: dark;
  --plane: #101625;        /* page */
  --surface: #172033;      /* panels */
  --raised: #1c273c;       /* rows, cards */
  --raised-2: #26334c;     /* hover */
  --line: #303d54;         /* hairline */
  --line-strong: #53627b;
  --ink: #f3f5fb;
  --ink-2: #c0cbdc;
  --muted: #a4b2c8;
  --accent: #80dfc5;       /* fast path / bundle */
  --accent-ink: #0b1a13;
  --info: #adaeff;         /* generative provider / reasoning */
  --warn: #f0c681;         /* mismatch, abstain, scripted */
  --bad: #ff9fba;          /* errors, retries */
  --adv: #c9b8ff;          /* advisory smart tool */
  --focus: #8ee9c5;
  --sans: "Avenir Next", Avenir, -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --header-h: 58px;
}
* { box-sizing: border-box; }
html, body { height: 100%; }
body { margin: 0; background: var(--plane); color: var(--ink); font: 13px/1.45 var(--sans); -webkit-font-smoothing: antialiased; }
button, input, select { font: inherit; }
button { cursor: pointer; color: inherit; background: var(--raised); border: 1px solid var(--line-strong); border-radius: 6px; padding: 6px 10px; transition: background .12s, border-color .12s; }
button:hover { background: var(--raised-2); }
button:disabled { cursor: default; opacity: .5; }
button:focus-visible, input:focus-visible, select:focus-visible, summary:focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
h1, h2, h3, h4, p { margin: 0; }
h1 { font-size: 20px; font-weight: 650; letter-spacing: -.3px; line-height: 1.2; }
h2 { font-size: 13px; font-weight: 600; color: var(--ink-2); }
h3 { font-size: 15px; font-weight: 650; }
h4 { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
input[type=search], input[type=password], select { min-width: 0; border: 1px solid var(--line-strong); background: var(--raised); color: var(--ink); border-radius: 6px; padding: 6px 9px; }
input[type=checkbox] { accent-color: var(--accent); }
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); }
.skip { position: absolute; left: 10px; top: -80px; z-index: 10; background: var(--raised); padding: 12px; }
.skip:focus { top: 10px; }
.mono { font-family: var(--mono); font-size: 11px; }
[hidden] { display: none !important; }

/* ---------- header ---------- */
.app-header { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; padding: 0 18px; border-bottom: 1px solid var(--line); background: var(--surface); gap: 16px; position: relative; z-index: 1; }
.brand { display: flex; align-items: center; gap: 10px; }
.brand svg { color: var(--accent); }
.brand strong { display: block; font-size: 17px; font-weight: 650; letter-spacing: -.5px; line-height: 1.2; }
.brand span { display: block; font-size: 11px; color: var(--muted); }
.header-actions { display: flex; align-items: center; gap: 8px; min-width: 0; }
.quiet { font-size: 12px; padding: 5px 9px; background: transparent; }
.follow { font-size: 12px; padding: 5px 10px; color: var(--accent); border-color: rgba(52,211,153,.35); background: rgba(52,211,153,.08); }
.follow[aria-pressed="false"] { color: var(--ink-2); border-color: var(--line-strong); background: transparent; }
.connection { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; padding: 4px 9px 4px 7px; border: 1px solid var(--line-strong); border-radius: 999px; white-space: nowrap; }
.connection::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
.connection.connected::before { background: var(--accent); box-shadow: 0 0 0 3px rgba(52,211,153,.18); }
.connection.problem { border-color: rgba(255,128,128,.45); }
.connection.problem::before { background: var(--bad); }
.connection.replay::before { background: var(--warn); }
.freshness { font-size: 11px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 260px; }
.connection-notice { padding: 8px 18px; background: #3b2f1c; border-bottom: 1px solid #6b5326; color: #f3d48a; font-size: 12px; }
.reconnect-panel { padding: 12px 18px; background: var(--surface); border-bottom: 1px solid var(--line); }
.reconnect-panel p { margin-bottom: 10px; max-width: 80ch; color: var(--ink-2); }
.reconnect-panel form { display: flex; gap: 8px; align-items: center; max-width: 760px; }
.reconnect-panel input { flex: 1; }

/* ---------- layout ---------- */
.app-layout { display: grid; grid-template-columns: 200px minmax(480px, 1fr) 300px; height: calc(100vh - var(--header-h)); }
.sessions-panel, .activity-panel, .detail-panel { min-width: 0; overflow-y: auto; overscroll-behavior: contain; }
.sessions-panel { padding: 16px 12px; border-right: 1px solid var(--line); background: var(--surface); }
.activity-panel { padding: 24px 28px 28px; }
.detail-panel { border-left: 1px solid var(--line); padding: 16px 18px; background: var(--surface); }

/* ---------- sessions ---------- */
.sessions-heading { display: flex; align-items: center; justify-content: space-between; margin: 0 4px 10px; }
.count { font-size: 11px; font-family: var(--mono); background: var(--raised-2); border-radius: 4px; padding: 1px 6px; color: var(--ink-2); }
.search { width: 100%; font-size: 12px; margin-bottom: 10px; }
.all-sessions { width: 100%; display: flex; justify-content: space-between; align-items: center; background: transparent; border-color: transparent; font-weight: 600; font-size: 12px; margin-bottom: 4px; padding: 7px 10px; }
.all-sessions.selected { color: var(--accent); background: rgba(52,211,153,.1); }
.session-list { display: flex; flex-direction: column; gap: 2px; }
.session-group { position: relative; }
.session-row { width: 100%; text-align: left; background: transparent; border-color: transparent; padding: 8px 10px; border-radius: 6px; display: block; }
.session-row:hover { background: var(--raised); }
.session-row.selected { background: var(--raised); border-color: var(--line-strong); box-shadow: inset 2px 0 var(--accent); }
.session-row.child { margin-left: 14px; width: calc(100% - 14px); border-left: 1px solid var(--line-strong); border-radius: 0 6px 6px 0; }
.session-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
.session-name { font-size: 13px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.session-name.unnamed { font-family: var(--mono); font-weight: 500; }
.session-age { font-size: 11px; color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
.session-meta { display: flex; align-items: center; gap: 6px; margin-top: 4px; min-width: 0; }
.session-id { font-family: var(--mono); font-size: 10.5px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.session-config { font-size: 11px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.session-state { display: inline-flex; align-items: center; gap: 5px; margin-top: 5px; font-size: 11px; color: var(--ink-2); }
.session-state::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--muted); flex: none; }
.session-state.working::before { background: var(--accent); animation: pulse 1.6s ease-in-out infinite; }
.session-state.idle::before { background: var(--accent); }
.session-state.issue { color: var(--bad); }
.session-state.issue::before { background: var(--bad); }
.session-state.closed, .session-state.stale { color: var(--muted); }
.children-toggle { font-size: 11px; background: transparent; border: 0; color: var(--info); padding: 3px 10px 6px 24px; }
.children-option { font-size: 11px; color: var(--ink-2); display: flex; align-items: center; gap: 6px; margin: 14px 6px 0; }
.sidebar-note { border-top: 1px solid var(--line); padding: 12px 6px 0; margin-top: 16px; font-size: 11px; color: var(--muted); line-height: 1.5; }
@keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(52,211,153,.55); } 60% { box-shadow: 0 0 0 5px rgba(52,211,153,0); } }

/* ---------- workspace heading + KPIs ---------- */
.workspace-heading { display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; margin-bottom: 14px; }
.workspace-heading p { font-size: 12px; color: var(--muted); margin-top: 4px; max-width: 70ch; }
.time-filter select { font-size: 12px; padding: 5px 8px; }
.kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr)); gap: 0; border-block: 1px solid var(--line); padding: 12px 0; }
.kpi { border-right: 1px solid var(--line); padding: 2px 11px; min-width: 0; }
.kpi:last-child { border-right: 0; }
.kpi span { display: block; font-size: 10.5px; color: var(--muted); line-height: 1.25; min-height: 26px; }
.kpi strong { display: block; font-size: 24px; font-weight: 500; line-height: 1.2; margin-top: 5px; letter-spacing: -.5px; }
.kpi.accent strong { color: var(--accent); }
.kpi.bad strong { color: var(--ink); }
.kpi.bad.has-issues strong { color: var(--bad); }
.kpi-note { font-size: 11px; color: var(--muted); line-height: 1.5; margin: 8px 2px 14px; }
.study-panel { border: 1px solid var(--line); border-radius: 10px; padding: 14px; margin-bottom: 16px; }
.study-heading { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
.study-heading h2 { margin: 0; font-size: 14px; }
.study-heading span, .study-panel p { color: var(--muted); font-size: 12px; }
.study-panel progress { width: 100%; height: 6px; margin: 12px 0; accent-color: #65ddb4; }
.study-panel summary { cursor: pointer; font-size: 12px; }
.study-table-wrap { overflow-x: auto; }
.study-panel table { width: 100%; text-align: left; font-size: 12px; border-collapse: collapse; margin-top: 10px; }
.study-panel th, .study-panel td { padding: 7px; border-bottom: 1px solid var(--line); white-space: nowrap; }
.impact-evidence { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px; margin-top: 10px; }
.impact-evidence > div { padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; }
.impact-evidence span, .impact-evidence strong, .impact-evidence small { display: block; }
.impact-evidence span, .impact-evidence small { color: var(--muted); font-size: 11px; line-height: 1.5; }
.impact-evidence strong { font-size: 14px; margin: 3px 0; }

/* ---------- toolbar ---------- */
.feed-toolbar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--line); gap: 12px; margin-bottom: 12px; }
.feed-tabs { display: flex; gap: 18px; }
.feed-tabs button { border: 0; background: none; border-bottom: 2px solid transparent; border-radius: 0; padding: 8px 0 9px; font-size: 13px; color: var(--muted); margin-bottom: -1px; }
.feed-tabs button:hover { color: var(--ink); }
.feed-tabs button.active { color: var(--ink); border-bottom-color: var(--accent); font-weight: 600; }
.synthetic-option { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--muted); white-space: nowrap; }

/* ---------- live: runtime strip ---------- */
.runtime-strip { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
.runtime-strip:empty { display: none; }
.runtime-pulse { display: inline-flex; align-items: center; gap: 7px; font-size: 11.5px; background: var(--surface); border-radius: 999px; padding: 4px 11px 4px 8px; border-color: var(--line); }
.runtime-pulse strong { font-weight: 600; }
.runtime-pulse span:last-child { color: var(--muted); }
.live-dot { width: 7px; height: 7px; background: var(--muted); border-radius: 50%; flex-shrink: 0; }
.runtime-pulse.working .live-dot { background: var(--accent); animation: pulse 1.6s ease-in-out infinite; }
.runtime-pulse.idle .live-dot { background: var(--accent); }
.runtime-pulse.issue .live-dot { background: var(--bad); }

/* ---------- live: decision ledger ---------- */
.ledger-heading, .flow-summary { display: grid; grid-template-columns: 58px 150px minmax(140px, 1.2fr) 22px minmax(140px, 1.2fr) 118px 62px; gap: 10px; align-items: center; }
.ledger-heading { font-size: 10.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .05em; padding: 0 12px 6px; }
.ledger-heading span:last-child { text-align: right; }
.ledger { display: flex; flex-direction: column; gap: 6px; }
.flow-card { background: var(--raised); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
.flow-card.in-flight { border-color: rgba(52,211,153,.45); box-shadow: inset 3px 0 var(--accent); }
.flow-card.selected-card { border-color: var(--line-strong); }
.flow-card:not(.selected-card):not(.in-flight) .flow-stages,
.flow-card:not(.selected-card):not(.in-flight) .flow-outcome { display: none; }
.flow-card.selected-card { border-color: var(--accent); }
.ledger-help { font-size: 11px; color: var(--muted); margin-bottom: 12px; }
.flow-inspect { display: block; padding: 2px 0; margin-top: 4px; background: transparent; border: 0; color: var(--ink-2); font-size: 11px; text-decoration: underline; text-underline-offset: 3px; }
.flow-inspect:hover, .flow-inspect[aria-pressed="true"] { color: var(--accent); background: transparent; }
.measurement-notes { margin: 10px 0 18px; }
.measurement-notes > summary { cursor: pointer; color: var(--muted); font-size: 11px; width: fit-content; }
.measurement-notes[open] > summary { margin-bottom: 12px; }
.flow-summary { padding: 9px 12px 8px; }
.flow-summary > * { min-width: 0; }
.flow-when { font-family: var(--mono); font-size: 11px; color: var(--ink-2); font-variant-numeric: tabular-nums; line-height: 1.3; }
.flow-when small { display: block; color: var(--muted); font-size: 10px; }
.clamp2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere; line-height: 1.3; }
.flow-session { border: 0; padding: 0; background: transparent; text-align: left; font-weight: 600; font-size: 12.5px; width: 100%; border-radius: 0; }
.flow-session:hover { color: var(--accent); background: transparent; }
.flow-session-wrap { min-width: 0; }
.flow-session-wrap .tagline { display: flex; align-items: center; gap: 5px; margin-top: 3px; min-width: 0; }
.flow-parent { color: var(--muted); font-size: 10.5px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.flow-cell strong { font-size: 12.5px; font-weight: 600; }
.flow-cell strong.id { font-family: var(--mono); font-size: 12px; }
.flow-cell span { display: block; font-size: 11px; color: var(--muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.flow-card.native { opacity: .75; }
.flow-card.native:hover { opacity: 1; }
.flow-cell .prob { display: flex; align-items: center; gap: 6px; margin-top: 3px; }
.prob-bar { height: 4px; flex: 1; max-width: 120px; background: var(--line-strong); border-radius: 2px; overflow: hidden; }
.prob-bar i { display: block; height: 100%; background: var(--accent); border-radius: 2px; }
.flow-cell .prob b { font-size: 11px; font-weight: 600; color: var(--ink-2); font-variant-numeric: tabular-nums; }
.flow-arrow { color: var(--muted); text-align: center; font-size: 14px; }
.flow-arrow.pending { color: var(--accent); animation: blink 1.2s ease-in-out infinite; }
@keyframes blink { 50% { opacity: .25; } }
.flow-latency { text-align: right; font-family: var(--mono); font-size: 11px; color: var(--ink-2); font-variant-numeric: tabular-nums; }
.flow-latency small { display: block; color: var(--muted); font-size: 10px; font-family: var(--sans); }

/* verdict chips + tags share one vocabulary */
.tag, .verdict { display: inline-flex; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 600; padding: 2px 7px; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--ink-2); background: transparent; white-space: nowrap; letter-spacing: .01em; }
.verdict { font-size: 11px; padding: 3px 9px; }
.verdict::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex: none; }
.tone-ok, .verdict.ok, .tag.ok { color: var(--accent); border-color: rgba(52,211,153,.4); background: rgba(52,211,153,.1); }
.tone-info, .verdict.info, .tag.info { color: var(--info); border-color: rgba(124,180,255,.4); background: rgba(124,180,255,.1); }
.tone-warn, .verdict.warn, .tag.warn, .tag.synthetic { color: var(--warn); border-color: rgba(245,192,75,.4); background: rgba(245,192,75,.1); }
.tone-bad, .verdict.bad, .tag.bad, .tag.error { color: var(--bad); border-color: rgba(255,128,128,.45); background: rgba(255,128,128,.1); }
.tone-adv, .verdict.adv, .tag.adv { color: var(--adv); border-color: rgba(201,184,255,.4); background: rgba(201,184,255,.1); }
.verdict.live { color: var(--accent); border-style: dashed; background: transparent; }
.verdict.live::before { animation: pulse 1.6s ease-in-out infinite; }

/* stage chain: compact connected pills */
.flow-stages { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 0; padding: 0 12px 9px; }
.flow-stage { flex: none; display: inline-flex; flex-direction: column; align-items: flex-start; gap: 1px; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 4px 9px; text-align: left; min-width: 0; max-width: 220px; position: relative; }
.flow-stage + .flow-stage { margin-left: 16px; }
.flow-stage + .flow-stage::before { content: '›'; position: absolute; left: -13px; top: 50%; transform: translateY(-50%); color: var(--muted); font-size: 13px; line-height: 1; }
.flow-stage strong { font-size: 11px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }
.flow-stage span { font-size: 10px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 200px; }
.flow-stage .flow-duration { color: var(--ink-2); font-family: var(--mono); }
.flow-stage:hover { background: var(--raised-2); }
.flow-stage.selected { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
.flow-stage.decision { border-left: 3px solid var(--accent); }
.flow-stage.error { border-left: 3px solid var(--bad); }
.flow-stage.synthetic { border-left: 3px solid var(--warn); }
.flow-stage.runtime { border-left: 3px solid var(--line-strong); }
.flow-outcome { font-size: 11px; color: var(--muted); padding: 0 12px 9px; }
.flow-status { font-size: 11px; color: var(--muted); margin-top: 10px; }
.flow-empty { font-size: 13px; line-height: 1.7; color: var(--muted); padding: 28px 12px; border: 1px dashed var(--line-strong); border-radius: 8px; margin-top: 8px; }
.arriving { animation: record-arrival 1.4s ease-out; }
@keyframes record-arrival { from { box-shadow: inset 0 0 0 2px var(--accent); background: rgba(52,211,153,.18); } to { box-shadow: inset 0 0 0 0 transparent; } }
.flow-card.arriving { animation: card-arrival 1.4s ease-out; }
@keyframes card-arrival { from { border-color: var(--accent); background: rgba(52,211,153,.12); } to { background: var(--raised); } }

/* ---------- event feed ---------- */
.feed-heading { display: grid; grid-template-columns: 22px minmax(0, 1fr) 130px 120px 70px; gap: 10px; color: var(--muted); font-size: 10.5px; text-transform: uppercase; letter-spacing: .05em; padding: 0 10px 6px; }
.feed-heading span:last-child { text-align: right; }
.feed { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--raised); }
.event-row { display: grid; grid-template-columns: 22px minmax(0, 1fr) 130px 120px 70px; gap: 10px; align-items: start; border: 0; border-top: 1px solid var(--line); border-radius: 0; padding: 8px 10px; background: transparent; text-align: left; width: 100%; }
.event-row:first-child { border-top: 0; }
.event-row:hover { background: var(--raised-2); }
.event-row.selected { background: rgba(52,211,153,.08); box-shadow: inset 3px 0 var(--accent); }
.event-row:focus-visible { outline-offset: -2px; }
.event-icon { width: 18px; height: 18px; margin-top: 1px; border-radius: 4px; background: var(--line-strong); color: var(--ink-2); font-size: 11px; display: flex; align-items: center; justify-content: center; font-weight: 700; }
.event-icon.decision { background: rgba(52,211,153,.18); color: var(--accent); }
.event-icon.error { background: rgba(255,128,128,.18); color: var(--bad); }
.event-icon.synthetic { background: rgba(245,192,75,.18); color: var(--warn); }
.event-title { font-size: 12.5px; font-weight: 600; display: block; overflow-wrap: anywhere; }
.event-description { display: block; font-size: 11.5px; color: var(--muted); margin-top: 1px; overflow-wrap: anywhere; }
.event-source { font-size: 11px; color: var(--ink-2); padding-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.event-session { font-size: 11px; color: var(--muted); padding-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.event-time { text-align: right; font-size: 11px; color: var(--muted); padding-top: 2px; font-family: var(--mono); font-variant-numeric: tabular-nums; white-space: nowrap; }
.event-duration { display: block; color: var(--ink-2); margin-top: 2px; }
.empty-state { text-align: center; padding: 48px 20px 60px; border: 1px dashed var(--line-strong); border-radius: 8px; }
.empty-state h2 { font-size: 15px; font-weight: 600; text-transform: none; letter-spacing: 0; color: var(--ink); margin-bottom: 6px; }
.empty-state p { font-size: 12px; color: var(--muted); max-width: 50ch; margin: auto; }
.feed-footer { display: flex; justify-content: space-between; gap: 16px; padding-top: 10px; margin-top: 8px; font-size: 11px; color: var(--muted); }

/* ---------- details ---------- */
.detail-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
.detail-empty p { font-size: 12px; color: var(--muted); margin-bottom: 12px; line-height: 1.6; }
#detailTitle { font-size: 16px; font-weight: 650; letter-spacing: -.2px; line-height: 1.3; overflow-wrap: anywhere; }
#detailDescription { font-size: 12px; color: var(--ink-2); margin: 6px 0 14px; line-height: 1.5; overflow-wrap: anywhere; }
.facts { margin: 0; border-top: 1px solid var(--line); }
.facts > div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 8px; border-bottom: 1px solid var(--line); padding: 6px 0; }
.facts dt { font-size: 11px; color: var(--muted); }
.facts dd { font-size: 11.5px; margin: 0; overflow-wrap: anywhere; }
.facts dd.mono { font-family: var(--mono); font-size: 11px; color: var(--ink-2); }
.runtime-config { margin-top: 16px; }
.runtime-config p { font-size: 11.5px; color: var(--ink-2); margin: 6px 0 0; line-height: 1.55; }
#distribution { margin-top: 16px; }
.score-meaning { font-size: 11px; color: var(--muted); margin: 5px 0 10px; }
.prob-row { margin-bottom: 8px; }
.prob-label { display: flex; justify-content: space-between; font-size: 11.5px; gap: 10px; overflow-wrap: anywhere; }
.prob-label b { font-weight: 600; }
.prob-label span:last-child { font-family: var(--mono); font-variant-numeric: tabular-nums; color: var(--ink-2); }
.prob-track { height: 5px; background: var(--line-strong); margin-top: 4px; border-radius: 3px; overflow: hidden; }
.prob-fill { height: 100%; background: var(--line-strong); filter: brightness(1.6); border-radius: 3px; }
.prob-row.chosen .prob-fill { background: var(--accent); filter: none; }
.prob-row.reason .prob-fill { background: var(--info); filter: none; }
.metadata { border-top: 1px solid var(--line); margin-top: 16px; padding-top: 10px; }
.metadata summary { cursor: pointer; font-size: 11.5px; color: var(--muted); }
pre { font: 11px/1.55 var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; max-height: 420px; overflow: auto; color: var(--ink-2); background: var(--plane); border-radius: 6px; padding: 8px; margin: 8px 0 0; }

/* ---------- selected decision circuit ---------- */
.circuit-map.fresh-score .shared-wire { animation: route-arrival 1.4s ease-out; stroke: var(--accent); }
.circuit-map.fresh-fast .fast-wire, .circuit-map.fresh-slow .slow-wire { animation: route-arrival 1.4s ease-out; }
@keyframes route-arrival { from { stroke-dasharray: 8 16; stroke-dashoffset: 96; stroke-width: 4; } to { stroke-dasharray: 8 16; stroke-dashoffset: 0; stroke-width: 2; } }
.decision-circuit { border: 1px solid var(--line); border-radius: 10px; background: var(--surface); margin: 0 0 18px; overflow: hidden; }
.circuit-heading { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 18px; cursor: pointer; list-style: none; }
.circuit-heading::-webkit-details-marker { display: none; }
.circuit-heading:hover { background: var(--raised); }
.circuit-heading strong { display: block; font-size: 18px; line-height: 1.2; color: var(--ink); font-weight: 550; letter-spacing: -.3px; }
#circuitContext { display: block; color: var(--muted); font-size: 11px; margin-top: 5px; overflow-wrap: anywhere; }
.circuit-disclosure { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: 11px; white-space: nowrap; }
.decision-circuit[open] .when-closed, .decision-circuit:not([open]) .when-open { display: none; }
.decision-circuit[open] .circuit-disclosure > [aria-hidden] { transform: rotate(180deg); }
.circuit-legend { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; padding: 0 18px; color: var(--muted); font-size: 11px; }
.fast-key::before, .slow-key::before { content: ''; display: inline-block; vertical-align: middle; width: 16px; height: 2px; margin-right: 7px; background: var(--accent); }
.slow-key::before { background: var(--info); }
.circuit-legend .tag { margin-left: auto; }
.circuit-map { position: relative; height: 180px; margin: 4px 18px 8px; }
.circuit-wires { position: absolute; width: 100%; height: 100%; inset: 0; pointer-events: none; }
.wire { fill: none; stroke: var(--line-strong); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
.circuit-map[data-branch="fast"] .fast-wire { stroke: var(--accent); stroke-width: 2; }
.circuit-map[data-branch="slow"] .slow-wire { stroke: var(--info); stroke-width: 2; }
.circuit-node { position: absolute; display: flex; flex-direction: column; justify-content: center; text-align: left; gap: 5px; min-height: 64px; padding: 10px; background: var(--surface); border: 1px solid var(--line-strong); border-radius: 7px; }
.circuit-node:disabled { opacity: 1; cursor: default; }
.circuit-node:disabled:hover { background: var(--surface); }
.circuit-node span { font-size: 13px; font-weight: 600; line-height: 1.3; }
.circuit-node small { color: var(--muted); font-size: 10.5px; line-height: 1.4; overflow-wrap: anywhere; }
.circuit-node[aria-pressed="true"] { outline: 2px solid var(--focus); outline-offset: 3px; }
.state-node { left: 0; width: 17%; top: 58px; }
.judge-node { left: 23.5%; width: 19%; top: 58px; }
.judge-node:not(:disabled) { background: #223746; border-color: var(--accent); }
.judge-node span { font-size: 17px; font-weight: 500; color: var(--accent); }
.fast-node { left: 52%; width: 19%; top: 8px; }
.slow-node { left: 52%; width: 19%; top: 108px; }
.host-node { left: 81%; width: 19%; top: 58px; border-color: #8a7755; }
.host-node span { color: var(--warn); }
.circuit-map[data-branch="fast"] .fast-node { border-color: var(--accent); }
.circuit-map[data-branch="slow"] .slow-node { border-color: var(--info); }
.slow-node span { color: var(--info); }
.circuit-receipt { display: grid; grid-template-columns: minmax(0,1fr) 24px minmax(0,1.3fr) auto; align-items: center; gap: 14px; border-top: 1px solid var(--line); padding: 12px 18px; background: var(--raised); }
.receipt-label { display: block; color: var(--muted); font-size: 11px; margin-bottom: 5px; }
.circuit-receipt strong { display: block; font-size: 13px; font-weight: 550; overflow-wrap: anywhere; }
.receipt-arrow { color: var(--muted); }
#circuitOutcomeNote { color: var(--muted); font-size: 11px; display: block; margin-top: 4px; overflow-wrap: anywhere; }
.receipt-button { font-size: 11px; padding: 7px 10px; max-width: 160px; }
.receipt-button.ok { color: var(--accent); }.receipt-button.info { color: var(--info); }.receipt-button.bad { color: var(--bad); }.receipt-button.warn { color: var(--warn); }
.circuit-evidence { font-size: 11px; color: var(--muted); padding: 0 18px 12px; background: var(--raised); line-height: 1.5; }

/* ---------- responsive ---------- */
@media (min-width: 1700px) {
  .app-layout { grid-template-columns: 280px minmax(480px, 1fr) 380px; }
  .activity-panel { padding: 22px 32px; }
}
@media (max-width: 1450px) {
  .kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px 0; }
  .kpi:nth-child(4) { border-right: 0; }
  .ledger-heading { display: none; }
  .flow-summary { grid-template-columns: 58px minmax(120px, 1fr) minmax(120px, 1fr) 22px minmax(120px, 1fr) 112px; }
  .flow-summary .verdict-cell { grid-column: 6; grid-row: 1; justify-self: end; }
  .flow-summary .flow-latency { grid-column: 6; grid-row: 2; text-align: right; margin-top: -6px; }
}
@media (max-width: 1100px) {
  .app-layout { grid-template-columns: 200px minmax(0, 1fr); grid-template-rows: minmax(0, calc(100vh - var(--header-h))) auto; height: auto; min-height: calc(100vh - var(--header-h)); align-content: start; }
  .sessions-panel { grid-row: 1 / 3; }
  .sessions-panel { height: calc(100vh - var(--header-h)); overflow-y: auto; }
  .detail-panel { grid-column: 2; border-left: 0; border-top: 1px solid var(--line); }
  .sessions-panel, .activity-panel, .detail-panel { overflow: visible; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 0 20px; }
}
@media (max-width: 1000px) {
  .app-header { height: auto; min-height: var(--header-h); padding: 10px 14px; flex-wrap: wrap; gap: 8px; }
  .header-actions { flex-wrap: wrap; gap: 6px; }
  .freshness { display: none; }
  .quiet, .follow { font-size: 11px; padding: 4px 8px; }
  .connection-notice, .reconnect-panel { padding: 10px 14px; }
  .reconnect-panel form { flex-wrap: wrap; }
  .reconnect-panel label { width: 100%; }
  .reconnect-panel input { width: 60%; }
  .app-layout { display: block; height: auto; }
  .sessions-panel { height: auto; border-right: 0; border-bottom: 1px solid var(--line); padding: 12px 14px; max-height: 240px; overflow: auto; }
  .search { display: none; }
  .all-sessions { width: auto; display: inline-flex; gap: 10px; margin: 0 6px 0 0; vertical-align: top; }
  .session-list { display: inline-flex; flex-direction: row; max-width: 100%; overflow-x: auto; vertical-align: top; align-items: flex-start; }
  .session-group { display: inline-block; }
  .session-row { width: 180px; flex: none; padding: 7px 9px; }
  .session-row.child { margin-left: 0; width: 180px; }
  .sidebar-note, .session-state { display: none; }
  .children-option { margin: 8px 0 0; }
  .activity-panel { padding: 14px 14px 20px; }
  h1 { font-size: 18px; }
  .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px; }
  .kpi strong { font-size: 18px; }
  .kpi:nth-child(even) { border-right: 0; }
  .circuit-heading { padding: 14px; align-items: flex-start; gap: 10px; }
  .circuit-heading strong { font-size: 17px; }
  .circuit-legend { padding: 0 14px; gap: 12px; }
  .circuit-map { height: auto; margin: 18px 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .circuit-wires { display: none; }
  .circuit-node { position: static; width: auto; min-width: 0; min-height: 78px; }
  .host-node { grid-column: 1 / -1; min-height: 62px; }
  .circuit-receipt { grid-template-columns: 1fr; padding: 16px; gap: 14px; }
  .receipt-arrow { display: none; }
  .receipt-button { justify-self: start; }
  .circuit-evidence { padding: 0 16px 16px; }
  .feed-toolbar { flex-wrap: wrap; }
  .feed-tabs { gap: 12px; }
  .feed-tabs button { font-size: 12px; }
  .flow-summary { grid-template-columns: 1fr 1fr; gap: 6px 10px; padding: 9px 10px; }
  .flow-summary .flow-when { grid-column: 1; }
  .flow-summary .flow-session-wrap { grid-column: 2; }
  .flow-summary .flow-cell { grid-column: 1 / 3; }
  .flow-summary .flow-arrow { display: none; }
  .flow-summary .verdict-cell { grid-column: 1; }
  .flow-summary .flow-latency { grid-column: 2; text-align: right; }
  .flow-stages { padding: 0 10px 8px; }
  .feed-heading { grid-template-columns: 18px 1fr 60px; padding: 0 8px 6px; }
  .feed-heading span:nth-child(3), .feed-heading span:nth-child(4) { display: none; }
  .event-row { grid-template-columns: 18px minmax(0, 1fr) 60px; gap: 8px; padding: 8px; }
  .event-source, .event-session { grid-column: 2; padding: 0; font-size: 10.5px; }
  .event-time { grid-column: 3; grid-row: 1; }
  .detail-panel { padding: 14px; border-left: 0; border-top: 1px solid var(--line); }
  .facts { display: block; }
}
@media (prefers-reduced-motion: reduce) {
  *, .arriving, .flow-card.arriving, .session-state.working::before, .runtime-pulse.working .live-dot, .verdict.live::before, .flow-arrow.pending { animation: none !important; transition: none !important; }
}

.savings-panel { border: 1px solid var(--line); border-radius: 10px; padding: 14px; margin: 12px 0 16px; }
.savings-heading { display: flex; align-items: baseline; gap: 12px; }
.savings-heading h2 { font-size: 14px; margin: 0; }
.savings-heading span, .savings-note, .savings-grid small { color: var(--muted); font-size: 12px; }
.savings-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; margin-top: 10px; }
.savings-grid > div { padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; }
.savings-grid span, .savings-grid strong, .savings-grid small { display: block; }
.savings-grid strong { font-size: 20px; margin: 2px 0; }
.savings-days { display: flex; align-items: flex-end; gap: 3px; height: 40px; margin-top: 12px; }
.savings-days > i { flex: 1; min-width: 4px; max-width: 18px; background: #65ddb4; border-radius: 2px 2px 0 0; opacity: .85; }
.savings-note { margin: 8px 0 0; }

.kpis:not(.has-shortcut) .shortcut-kpi { display: none; }
.session-context { display: block; font-size: 11.5px; color: var(--muted); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.savings-projects { display: grid; gap: 4px; margin-top: 10px; font-size: 12px; }
.savings-project { display: grid; grid-template-columns: minmax(120px, 1.2fr) 1.4fr 0.6fr 1.4fr; gap: 8px; padding: 4px 0; border-bottom: 1px solid var(--line); }
.savings-project small { color: var(--muted); }
</style>
</head>
<body>
<a class="skip" href="#activity">Skip to activity</a>
<header class="app-header">
  <div class="brand"><svg viewBox="0 0 28 30" width="22" height="24" aria-hidden="true"><path d="M4 21 8 9M11 25 17 5M19 21 23 9" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg><div><strong>Fast Decisions</strong><span>Amplifier observatory</span></div></div>
  <div class="header-actions">
    <span id="connection" class="connection" role="status">Connecting</span>
    <span id="freshness" class="freshness">Waiting for first response</span>
    <button id="followBtn" class="follow" aria-pressed="true">Following live</button>
    <button id="loadBtn" class="quiet">Open trace</button>
    <button id="exportBtn" class="quiet">Export</button>
    <input id="fileInput" type="file" accept=".jsonl,.json" multiple hidden>
  </div>
</header>
<div id="connectionNotice" class="connection-notice" role="status" hidden></div>
<section id="reconnectPanel" class="reconnect-panel" hidden aria-label="Reconnect viewer">
  <p>Open the full viewer link from the launching terminal, or paste it here. This is the local viewer link, not a model API key.</p>
  <form id="connectForm"><label for="viewerLink">Viewer link</label><input id="viewerLink" type="password" autocomplete="off" placeholder="http://127.0.0.1:…/#token=…"><button type="submit">Connect</button></form>
</section>
<div class="app-layout">
  <aside class="sessions-panel" aria-label="Sessions">
    <div class="sessions-heading"><h2>Sessions</h2><span id="sessionCount" class="count">0</span></div>
    <label class="sr-only" for="sessionSearch">Find a session</label><input id="sessionSearch" class="search" type="search" placeholder="Find a session…">
    <button id="allSessions" class="all-sessions selected" aria-pressed="true"><span>All sessions</span><span id="allSessionCount" class="count">0</span></button>
    <div id="sessions" class="session-list"></div>
    <label class="children-option"><input type="checkbox" id="includeChildren" checked> Include child sessions</label>
    <div class="sidebar-note"><p>Local, read-only telemetry. Only sessions with the bundle loaded report here. Names are the session's working directory, never a full path.</p></div>
  </aside>
  <main id="activity" class="activity-panel">
    <div class="workspace-heading">
      <div><h1 id="viewTitle">All sessions</h1><p id="viewSubtitle">Runtime activity reported by the fast-decisions bundle.</p></div>
      <label class="time-filter"><span class="sr-only">Time window</span><select id="timeWindow"><option value="3600000">Last hour</option><option value="86400000" selected>Last 24 hours</option><option value="all">All retained</option></select></label>
    </div>
    <details id="decisionCircuit" class="decision-circuit" open>
      <summary class="circuit-heading"><span><strong>Decision path</strong><span id="circuitContext">Waiting for recorded decisions</span></span><span class="circuit-disclosure"><span class="when-open">Hide path</span><span class="when-closed">Show path</span><span aria-hidden="true">⌄</span></span></summary>
      <div class="circuit-legend"><span class="fast-key">Fast path</span><span class="slow-key">Generative path</span><span id="circuitMode" class="tag">No records</span><button id="circuitLatest" class="quiet" hidden>Follow latest decision</button></div>
      <div id="circuitMap" class="circuit-map" data-branch="unknown">
        <svg class="circuit-wires" viewBox="0 0 1000 220" preserveAspectRatio="none" aria-hidden="true"><path class="wire shared-wire" d="M160 110H235"/><path class="wire fast-wire" d="M420 110H465V49H520M705 49H758V110H810"/><path class="wire slow-wire" d="M420 110H465V171H520M705 171H758V110H810"/></svg>
        <button id="circuitState" class="circuit-node state-node" disabled><span>Current state</span><small id="circuitStateNote">No request recorded</small></button>
        <button id="circuitJudge" class="circuit-node judge-node" disabled><span>Fast judge</span><small id="circuitJudgeNote">No score recorded</small></button>
        <button id="circuitFast" class="circuit-node fast-node" disabled><span>Prepared action</span><small id="circuitFastNote">No fast route recorded</small></button>
        <button id="circuitSlow" class="circuit-node slow-node" disabled><span>Generative model</span><small id="circuitSlowNote">No invocation recorded</small></button>
        <button id="circuitHost" class="circuit-node host-node" disabled><span>Host controls execution</span><small id="circuitHostNote">Permissions stay upstream</small></button>
      </div>
      <div class="circuit-receipt"><div><span class="receipt-label">Judge proposed</span><strong id="circuitProposed">No proposal recorded</strong></div><span class="receipt-arrow" aria-hidden="true">→</span><div><span class="receipt-label">What happened</span><strong id="circuitHappened">No outcome recorded</strong><span id="circuitOutcomeNote"></span></div><button id="circuitReceipt" class="receipt-button" disabled>Awaiting evidence</button></div>
      <p id="circuitEvidence" class="circuit-evidence">Recorded routes light up as events arrive. Select a node to inspect its evidence.</p>
    </details>
    <section class="kpis" aria-label="Activity in the selected window">
      <div class="kpi" title="Per-request routing decisions (and any action scores) in this window"><span>Requests judged</span><strong id="modelCount">0</strong></div>
      <div class="kpi accent" title="Model calls that ran on the faster model"><span>On faster model</span><strong id="fastCount">0</strong></div>
      <div class="kpi" title="Model calls that ran on your usual model (hard requests, large projects, your own pick, or a switch)"><span>On usual model</span><strong id="usualCount">0</strong></div>
      <div class="kpi" title="Model calls moved to your usual model partway through a request (only earlier builds did this; the current default switches only after a service error)"><span>Switched mid-request</span><strong id="switchedCount">0</strong></div>
      <div class="kpi accent shortcut-kpi" title="Optional read shortcut: fast submissions with a successful tool execution"><span>Shortcut executed</span><strong id="fastExecuted">0</strong></div>
      <div class="kpi accent shortcut-kpi" title="Optional read shortcut: provider calls bypassed at the complete() boundary"><span>Calls bypassed</span><strong id="bypassedCount">0</strong></div>
      <div class="kpi" title="Shadow proposals that matched the tool the LLM actually chose"><span>Shadow matches</span><strong id="matchCount">—</strong></div>
      <div class="kpi" title="Tool results reported by hooks or measured execution"><span>Tool results</span><strong id="toolCount">0</strong></div>
      <div class="kpi bad" title="Provider retries, errors, fallbacks and failed executions"><span>Retries / errors</span><strong id="errorCount">0</strong></div>
      <div class="kpi" title="95th percentile of the decision-maker's time per decision"><span>Judge p95</span><strong id="scorerP95">—</strong></div>
    </section>
    <section id="efficiencyPanel" class="savings-panel" aria-label="Efficiency ledger">
      <div class="savings-heading"><h2>Efficiency ledger</h2><span id="effScope">Production traffic · from per-decision receipts</span></div>
      <div class="savings-grid">
        <div><span>Cost saved</span><strong id="effCost">—</strong><small id="effCostDetail"></small></div>
        <div><span>Time saved</span><strong id="effTime">—</strong><small id="effTimeDetail"></small></div>
        <div><span>Model calls saved</span><strong id="effCalls">—</strong><small id="effCallsDetail"></small></div>
      </div>
      <div id="effLevers" class="savings-projects" aria-label="By efficiency lever"></div>
      <div id="effProjects" class="savings-projects" aria-label="By project"></div>
      <div id="effHarness" class="savings-projects" aria-label="By harness"></div>
      <p id="effNote" class="savings-note"></p>
    </section>
    <details class="measurement-notes" id="legacySavings"><summary>Earlier estimate (before receipts)</summary>
    <section id="savingsPanel" class="savings-panel" aria-label="Estimated savings" hidden>
      <div class="savings-heading"><h2>Estimated savings</h2><span id="savingsScope"></span></div>
      <div class="savings-grid">
        <div><span>Cost saved</span><strong id="savingsCost">—</strong><small id="savingsCostDetail"></small></div>
        <div><span>Model time saved</span><strong id="savingsTime">—</strong><small id="savingsTimeDetail"></small></div>
        <div><span>Turns on the cheaper model</span><strong id="savingsTurns">—</strong><small id="savingsTurnsDetail"></small></div>
      </div>
      <div id="savingsDays" class="savings-days" role="img" aria-label="Estimated cost saved per day"></div>
      <div id="savingsProjects" class="savings-projects" aria-label="Savings by project"></div>
      <p id="savingsNote" class="savings-note"></p>
    </section>
    </details>
    <details class="measurement-notes"><summary>What these measurements tell us</summary>
    <section class="impact-evidence" aria-label="Impact evidence">
      <div><span>Poor tool calls diverted</span><strong>Not measured</strong><small>Bypassing a model call does not establish that a bad tool call was prevented.</small></div>
      <div><span>Net time and cost saved</span><strong>Estimated</strong><small>The savings panel prices and times cheaper-model turns at host-model rates. Only matched task comparisons (the eval suites) establish net savings and quality.</small></div>
    </section>
    <p class="kpi-note"><span id="impactDetail">Waiting for recorded fast-path execution.</span> <span id="qualityEvidence"></span> <span id="scopeNotice">Counts exclude scripted and demo events.</span> Eliminated tool calls and task quality are not measured here; savings are estimates.</p>
    </details>
    <section id="studyPanel" class="study-panel" aria-label="Live study progress" hidden>
      <div class="study-heading"><h2>Live three-arm study</h2><strong id="studyProgress"></strong><span id="studyStatus"></span></div>
      <progress id="studyMeter" value="0" max="432" aria-label="Study runs completed"></progress>
      <details><summary>Results so far · baseline / local / Jev</summary><div class="study-table-wrap"><table><thead><tr><th>Harness / arm</th><th>Completed</th><th>Passed</th><th>Median task time</th><th>FD requests</th></tr></thead><tbody id="studyRows"></tbody></table></div></details>
      <p id="studyNote">Collection is in progress. Results are preliminary.</p>
    </section>
    <div class="feed-toolbar">
      <div class="feed-tabs" role="group" aria-label="Event category"><button data-filter="live" class="active" aria-pressed="true">Decision ledger</button><button data-filter="activity" aria-pressed="false">All events</button><button data-filter="decisions" aria-pressed="false">Judgments</button><button data-filter="errors" aria-pressed="false">Issues</button></div>
      <label class="synthetic-option"><input type="checkbox" id="includeSynthetic"> Scripted &amp; demo <span id="syntheticCount"></span></label>
    </div>
    <section id="liveFlows" class="live-flows" aria-label="Live decision flows">
      <div id="runtimeStrip" class="runtime-strip"></div>
      <p class="ledger-help">Inspect a decision to follow its path and recorded stages.</p>
      <div class="ledger-heading"><span>When</span><span>Session</span><span>Model proposed</span><span></span><span>What happened</span><span>Verdict</span><span>Scoring</span></div>
      <div id="flowCards" class="ledger"></div>
      <p id="flowStatus" class="flow-status">Waiting for recorded events</p>
      <p id="flowEmpty" class="flow-empty">No decisions in this window. Start a turn in a session with the bundle loaded, or widen the time window. Scripted shadow proposals never bypass a model call.</p>
